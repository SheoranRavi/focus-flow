tenancy_ocid     = "ocid1.tenancy.oc1..REPLACE_ME"
compartment_ocid = "ocid1.compartment.oc1..REPLACE_ME"
region           = "REPLACE_WITH_YOUR_REGION"

# Get this from Oracle's Ubuntu 24.04 ARM64 image list for your region.
ubuntu_image_ocid = "ocid1.image.oc1..REPLACE_ME"

# Your public SSH key, e.g. the contents of ~/.ssh/id_ed25519.pub
public_ssh_key = "ssh-ed25519 AAAA... replace-me"

# Restrict SSH to your current public IP.
# Example: 203.0.113.10/32
admin_cidr = "REPLACE_WITH_YOUR_PUBLIC_IP/32"

# Optional. Leave empty to use the first AD in the tenancy.
availability_domain = ""
